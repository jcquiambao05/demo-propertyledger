    "multer": "^2.5.0",
    "next-auth": "^4.24.15",
    "node-cron": "4.6.0",
    "nodemailer": "10.3.1",
    "otplib": "^12.0.1",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
