{
  "name": "db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.20.0",
    "tsx": "^4.23.15"
  }
}
